<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= t('admin.radius.title', 'Pengaturan RADIUS') %> | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    .mtabs { display: flex; gap: 8px; border-bottom: 1px solid var(--border); padding-bottom: 12px; margin-bottom: 20px; flex-wrap: wrap; }
    .mtab { display: inline-flex; align-items: center; gap: 7px; padding: 9px 18px; border-radius: 8px; font-size: 13px; font-weight: 600; color: var(--muted); background: var(--bg2); border: 1px solid var(--border); cursor: pointer; transition: all .2s; }
    .mtab:hover { color: var(--text); background: rgba(255,255,255,0.06); }
    .mtab.active { color: #ffffff !important; background: var(--primary) !important; border-color: var(--primary) !important; box-shadow: 0 4px 12px var(--pdim); }
    
    html[data-theme="light"] .mtab { background: #ffffff !important; color: #64748b !important; border-color: #cbd5e1 !important; }
    html[data-theme="light"] .mtab:hover { color: #0f172a !important; background: #f1f5f9 !important; }
    html[data-theme="light"] .mtab.active { color: #ffffff !important; background: #4f46e5 !important; border-color: #4f46e5 !important; }

    .settings-form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 18px; }

    /* Mobile Responsive Optimizations */
    @media (max-width: 768px) {
      .settings-form-grid { grid-template-columns: 1fr; }
      .mtabs {
        overflow-x: auto;
        flex-wrap: nowrap;
        white-space: nowrap;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 8px;
        margin-bottom: 14px;
        scrollbar-width: thin;
      }
      .mtab {
        padding: 8px 14px;
        font-size: 12px;
        flex-shrink: 0;
      }
      .stat-grid {
        grid-template-columns: repeat(2, 1fr) !important;
        gap: 10px !important;
      }
      .tbl-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        width: 100%;
        margin-bottom: 0;
      }
      .dtbl {
        min-width: 600px;
      }
      .topbar .tb-title span {
        font-size: 13px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 180px;
      }
      .mo .mb {
        width: 95vw !important;
        max-width: 95vw !important;
        margin: 10px auto !important;
        padding: 14px !important;
        border-radius: 14px !important;
      }
      .mo .mbody {
        max-height: 70vh !important;
        overflow-y: auto !important;
        padding-right: 4px !important;
      }
      .mf {
        flex-wrap: wrap !important;
        gap: 8px !important;
      }
      .mf button, .mf a {
        flex: 1 1 100% !important;
        justify-content: center !important;
      }
    }
    @media (max-width: 480px) {
      .stat-grid {
        grid-template-columns: 1fr !important;
      }
      .topbar .tb-title span {
        max-width: 140px;
      }
    }
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: activePage || 'radius_settings', company }) %>

<div class="mw">
  <!-- TOPBAR -->
  <div class="topbar">
    <div class="tb-title">
      <button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
      <i class="bi bi-broadcast"></i>
      <span><%= t('admin.radius.title', 'Pengaturan RADIUS') %> &amp; Monitoring</span>
    </div>
    <div class="tb-right">
      <span class="adm-badge" style="font-size:12px;opacity:0.7;"><%= company %></span>
      <span class="adm-badge">
        <i class="bi bi-person-fill"></i> 
        <%= (typeof session !== 'undefined' && session && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %>
      </span>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i></a>
    </div>
  </div>

  <!-- CONTENT -->
  <div class="page">

    <% if (msg) { %>
    <div class="alert alert-<%= msg.type === 'danger' || msg.type === 'error' ? 'd' : msg.type === 'success' ? 's' : 'w' %> mb16" id="autoAlert">
      <i class="bi bi-<%= msg.type === 'success' ? 'check-circle' : 'exclamation-triangle' %>"></i>
      <%= msg.text %>
    </div>
    <% } %>

    <!-- SUMMARY STAT CARDS -->
    <div class="stat-grid mb16">
      <div class="sc p">
        <i class="bi bi-broadcast sc-icon"></i>
        <div class="sc-label" style="display:flex;align-items:center;justify-content:space-between;gap:6px;">
          <span>Status FreeRADIUS</span>
          <form action="/admin/radius/restart" method="POST" style="margin:0;">
            <button type="submit" class="btn btn-w btn-sm" style="font-size:10px;padding:2px 8px;height:auto;" title="Periksa status service FreeRADIUS">
              <i class="bi bi-arrow-clockwise"></i> Periksa
            </button>
          </form>
        </div>
        <div class="sc-val">
          <% if (radiusStatus.running) { %>
            <span class="badge bs"><i class="bi bi-play-circle-fill"></i> Running</span>
          <% } else { %>
            <span class="badge bd"><i class="bi bi-stop-circle-fill"></i> Stopped</span>
          <% } %>
        </div>
        <div class="sc-sub">SQL: <%= radiusStatus.sqlReady ? 'Siap' : 'Belum siap' %> · Auth <%= radiusStatus.authPort %> · Acct <%= radiusStatus.acctPort %> · CoA <%= radiusStatus.coaPort %></div>
      </div>

      <div class="sc s">
        <i class="bi bi-wifi sc-icon"></i>
        <div class="sc-label">User RADIUS Online</div>
        <div class="sc-val"><%= onlineSessions.length %></div>
        <div class="sc-sub">Sesi Aktif Terhubung Saat Ini</div>
      </div>

      <div class="sc i">
        <i class="bi bi-router sc-icon"></i>
        <div class="sc-label">NAS Router Client</div>
        <div class="sc-val"><%= nasList.length %></div>
        <div class="sc-sub">Router NAS Terdaftar di Server</div>
      </div>

      <div class="sc w">
        <i class="bi bi-activity sc-icon"></i>
        <div class="sc-label">Trafik RADIUS Hari Ini</div>
        <div class="sc-val"><%= typeof todayTrafficMB !== 'undefined' ? todayTrafficMB : '0.0' %><span style="font-size:14px;"> MB</span></div>
        <div class="sc-sub"><%= typeof todayEvents !== 'undefined' ? todayEvents : 0 %> Log Accounting Hari Ini</div>
      </div>
    </div>

    <!-- TABS NAVIGATION -->
    <div class="mtabs mb16">
      <button type="button" class="mtab active" id="tab-btn-online" onclick="switchTab('online')">
        <i class="bi bi-wifi"></i> Sesi Active RADIUS (<%= onlineSessions.length %>)
      </button>
      <button type="button" class="mtab" id="tab-btn-settings" onclick="switchTab('settings')">
        <i class="bi bi-sliders"></i> Pengaturan RADIUS
      </button>
      <button type="button" class="mtab" id="tab-btn-nas" onclick="switchTab('nas')">
        <i class="bi bi-router"></i> Daftar NAS Router (<%= nasList.length %>)
      </button>
      <button type="button" class="mtab" id="tab-btn-accounting" onclick="switchTab('accounting')">
        <i class="bi bi-journal-text"></i> Log Accounting
      </button>
    </div>

    <!-- TAB 1: PENGATURAN RADIUS -->
    <div id="tab-content-settings" class="tab-pane" style="display:none;">
      <form action="/admin/radius-settings" method="POST">
        <div class="settings-form-grid mb16">
          
          <!-- Card 1: Core Service Settings -->
          <div class="card mb16">
            <div class="card-hd" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
              <h6 style="margin:0;"><i class="bi bi-cpu"></i> Integrasi FreeRADIUS</h6>
              <button type="submit" formaction="/admin/radius/sync-users" formmethod="POST" class="btn btn-s btn-sm" onclick="return confirm('Sinkronkan ulang seluruh pelanggan yang memakai RADIUS?')"><i class="bi bi-arrow-repeat"></i> Sinkron Pelanggan</button>
            </div>
            <div class="card-bd">
              <div class="fg">
                <label class="fl">Status Service RADIUS</label>
                <select name="radius_enabled" class="fs">
                  <option value="1" <%= radiusStatus.enabled ? 'selected' : '' %>>Aktif (pelanggan dapat memakai FreeRADIUS)</option>
                  <option value="0" <%= !radiusStatus.enabled ? 'selected' : '' %>>Non-Aktif (Disabled)</option>
                </select>
                <small class="text-muted" style="font-size:11px;display:block;margin-top:4px;">
                  Tidak menjalankan server UDP Node.js. Service <code>freeradius</code> dikelola oleh systemd pada server Linux.
                </small>
              </div>
              <div class="alert alert-w" style="margin:0;">
                Setiap NAS wajib memiliki secret unik. NexaID tidak lagi memakai global shared secret.<br>
                <strong><%= radiusStatus.radiusUsers %></strong> akun saat ini tersimpan di tabel autentikasi FreeRADIUS.
              </div>
            </div>
          </div>

          <!-- Card 2: Port UDP & Protocol -->
          <div class="card mb16">
            <div class="card-hd">
              <h6><i class="bi bi-ethernet"></i> Port Jaringan UDP</h6>
            </div>
            <div class="card-bd">
              <div class="form-row">
                <div class="fg">
                  <label class="fl">Port Auth (UDP)</label>
                  <input type="number" name="radius_auth_port" class="fc" value="<%= radiusStatus.authPort %>" required>
                  <small class="text-muted" style="font-size:11px;display:block;margin-top:4px;">Default: 1812</small>
                </div>

                <div class="fg">
                  <label class="fl">Port Acct (UDP)</label>
                  <input type="number" name="radius_acct_port" class="fc" value="<%= radiusStatus.acctPort %>" required>
                  <small class="text-muted" style="font-size:11px;display:block;margin-top:4px;">Default: 1813</small>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 3: Limitasi Koneksi & Sesi -->
          <div class="card mb16">
            <div class="card-hd">
              <h6><i class="bi bi-speedometer2"></i> Limitasi Kecepatan & Sesi Aktif</h6>
            </div>
            <div class="card-bd">
              <div class="fg">
                <label class="fl">Pembatasan Sesi Aktif Ganda (Simultaneous-Use)</label>
                <select name="radius_limit_simultaneous" class="fs">
                  <option value="1" <%= (typeof radiusStatus.limitSimultaneous === 'undefined' || radiusStatus.limitSimultaneous) ? 'selected' : '' %>>Aktif - Batasi 1 Akun 1 Sesi Online (Rejek Login Ganda)</option>
                  <option value="0" <%= (typeof radiusStatus.limitSimultaneous !== 'undefined' && !radiusStatus.limitSimultaneous) ? 'selected' : '' %>>Non-Aktif - Bebas Multi-Login</option>
                </select>
                <small class="text-muted" style="font-size:11px;display:block;margin-top:4px;">
                  Mencegah 1 akun dipakai secara bersamaan di banyak perangkat.
                </small>
              </div>

              <div class="fg">
                <label class="fl">Default Rate Limit (Fallback Kecepatan)</label>
                <input type="text" name="radius_default_rate_limit" class="fc" value="<%= typeof radiusStatus.defaultRateLimit !== 'undefined' ? radiusStatus.defaultRateLimit : '5M/10M' %>" placeholder="Contoh: 5M/10M">
                <small class="text-muted" style="font-size:11px;display:block;margin-top:4px;">
                  Digunakan jika pengguna/pelanggan tidak terikat pada Paket Internet khusus. (Format: <code>Upload/Download</code>).
                </small>
              </div>
            </div>
          </div>

          <!-- Card 3: Isolir Settings -->
          <div class="card mb16">
            <div class="card-hd">
              <h6><i class="bi bi-shield-slash"></i> Isolir & Suspended Policy RADIUS</h6>
            </div>
            <div class="card-bd">
              <div class="fg">
                <label class="fl">Aksi Pelanggan Terisolir</label>
                <select name="radius_isolir_action" class="fs">
                  <option value="pool" <%= radiusStatus.isolirAction === 'pool' ? 'selected' : '' %>>Access-Accept dengan Dynamic IP Pool Isolir (Rekomendasi)</option>
                  <option value="reject" <%= radiusStatus.isolirAction === 'reject' ? 'selected' : '' %>>Access-Reject (Koneksi Ditolak Total)</option>
                </select>
              </div>

              <div class="fg">
                <label class="fl">Alokasi IP Pool Isolir oleh RADIUS Server</label>
                <select name="radius_isolir_ip_pool_enabled" class="fs">
                  <option value="1" <%= (typeof radiusStatus.isolirIpPoolEnabled === 'undefined' || radiusStatus.isolirIpPoolEnabled) ? 'selected' : '' %>>Aktif - Kirim Nama Pool Isolir ke MikroTik</option>
                  <option value="0" <%= (typeof radiusStatus.isolirIpPoolEnabled !== 'undefined' && !radiusStatus.isolirIpPoolEnabled) ? 'selected' : '' %>>Non-Aktif - Hanya Kirim Mikrotik-Group / Framed-Pool</option>
                </select>
                <small class="text-muted" style="font-size:11px;display:block;margin-top:4px;">FreeRADIUS memilih pool, sedangkan alamat IP tetap dialokasikan oleh MikroTik. Script NAS akan membuat pool bila belum ada.</small>
              </div>

              <div class="form-row">
                <div class="fg">
                  <label class="fl">Rentang IP Pool Isolir (Awal)</label>
                  <input type="text" name="radius_isolir_ip_pool_start" class="fc" value="<%= typeof radiusStatus.isolirIpPoolStart !== 'undefined' ? radiusStatus.isolirIpPoolStart : '10.250.99.2' %>" placeholder="10.250.99.2" required>
                </div>
                <div class="fg">
                  <label class="fl">Rentang IP Pool Isolir (Akhir)</label>
                  <input type="text" name="radius_isolir_ip_pool_end" class="fc" value="<%= typeof radiusStatus.isolirIpPoolEnd !== 'undefined' ? radiusStatus.isolirIpPoolEnd : '10.250.99.254' %>" placeholder="10.250.99.254" required>
                </div>
              </div>

              <div class="fg">
                <label class="fl">Kecepatan Limit Pelanggan Terisolir (Rate-Limit)</label>
                <input type="text" name="radius_isolir_rate_limit" class="fc" value="<%= typeof radiusStatus.isolirRateLimit !== 'undefined' ? radiusStatus.isolirRateLimit : '512k/512k' %>" placeholder="Contoh: 512k/512k atau 1M/1M" required>
                <small class="text-muted" style="font-size:11px;display:block;margin-top:4px;">Format: <code>Upload/Download</code> (misal: 512k/512k, 1M/1M, 256k/512k). Dikirimkan langsung ke MikroTik saat pelanggan terisolir.</small>
              </div>

              <div class="fg">
                <label class="fl">Nama Pool / Group Isolir RADIUS (Attribute)</label>
                <input type="text" name="radius_isolir_pool" class="fc" value="<%= radiusStatus.isolirPool %>" required>
                <small class="text-muted" style="font-size:11px;display:block;margin-top:4px;">Atribut Mikrotik-Group / Framed-Pool tambahan untuk pelanggan terisolir.</small>
              </div>
            </div>
          </div>

          <!-- Card 4: Dynamic IP Pool RADIUS -->
          <div class="card mb16">
            <div class="card-hd">
              <h6><i class="bi bi-diagram-3-fill"></i> Pembagian IP Pool RADIUS Otomatis</h6>
            </div>
            <div class="card-bd">
              <div class="fg">
                <label class="fl">Alokasi IP Dinamis oleh RADIUS Server</label>
                <select name="radius_ip_pool_enabled" class="fs">
                  <option value="1" <%= (typeof radiusStatus.ipPoolEnabled === 'undefined' || radiusStatus.ipPoolEnabled) ? 'selected' : '' %>>Aktif - RADIUS Bagikan IP Otomatis dari Rentang IP Pool (Rekomendasi)</option>
                  <option value="0" <%= (typeof radiusStatus.ipPoolEnabled !== 'undefined' && !radiusStatus.ipPoolEnabled) ? 'selected' : '' %>>Non-Aktif - Gunakan Dynamic Pool dari MikroTik (Framed-Pool)</option>
                </select>
                <small class="text-muted" style="font-size:11px;display:block;margin-top:4px;">
                  Jika aktif, RADIUS akan membagikan IP dinamis otomatis ke pelanggan tanpa IP statis sehingga tidak tergantung pada pool lokal MikroTik.
                </small>
              </div>

              <div class="form-row">
                <div class="fg">
                  <label class="fl">Rentang IP Pool Normal (Awal)</label>
                  <input type="text" name="radius_ip_pool_start" class="fc" value="<%= typeof radiusStatus.ipPoolStart !== 'undefined' ? radiusStatus.ipPoolStart : '10.250.10.2' %>" placeholder="10.250.10.2" required>
                </div>
                <div class="fg">
                  <label class="fl">Rentang IP Pool Normal (Akhir)</label>
                  <input type="text" name="radius_ip_pool_end" class="fc" value="<%= typeof radiusStatus.ipPoolEnd !== 'undefined' ? radiusStatus.ipPoolEnd : '10.250.10.254' %>" placeholder="10.250.10.254" required>
                </div>
              </div>

              <div class="fg">
                <label class="fl">Nama Framed Pool Default (Fallback)</label>
                <input type="text" name="radius_framed_pool" class="fc" value="<%= radiusStatus.framedPool %>" required>
              </div>
            </div>
          </div>

          <!-- Card 5: Panduan Firewall Linux UFW & Script MikroTik -->
          <div class="card mb16">
            <div class="card-hd" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
              <h6 style="margin:0;"><i class="bi bi-terminal-fill"></i> Script MikroTik per NAS</h6>
            </div>
            <div class="card-bd">
              <p style="margin:0 0 10px;">Tambahkan NAS pada tab <strong>Daftar NAS Router</strong>, kemudian klik <strong>Script</strong>. Script menggunakan IP L2TP NAS dan secret unik milik router tersebut.</p>
              <div class="alert alert-w" style="margin:0;">Setelah menambah, mengubah, menonaktifkan, atau merotasi secret NAS, jalankan <code>systemctl restart freeradius</code> pada server.</div>
            </div>
          </div>

        </div>

        <div>
          <button type="submit" class="btn btn-p"><i class="bi bi-save"></i> Simpan Konfigurasi RADIUS</button>
        </div>
      </form>
    </div>

    <!-- TAB 2: DAFTAR NAS CLIENTS -->
    <div id="tab-content-nas" class="tab-pane" style="display:none;">
      <div class="card mb16">
        <div class="card-hd" style="display:flex;justify-content:space-between;align-items:center;">
          <h6 style="margin:0;"><i class="bi bi-router"></i> Daftar Router NAS (Network Access Server)</h6>
          <button type="button" class="btn btn-p btn-sm" onclick="showModal('addNasModal')"><i class="bi bi-plus-lg"></i> Tambah NAS Client</button>
        </div>
        <div class="card-bd" style="padding:0;">
          <div class="tbl-wrap">
            <table class="dtbl">
              <thead>
                <tr>
                  <th>IP Address NAS</th>
                  <th>Nama Shortname</th>
                  <th>Shared Secret</th>
                  <th>Keterangan</th>
                  <th>Status</th>
                  <th style="width:230px;text-align:right;">Aksi</th>
                </tr>
              </thead>
              <tbody>
                <% if (nasList && nasList.length > 0) { %>
                  <% nasList.forEach(nas => { %>
                    <tr>
                      <td><strong><%= nas.nasname %></strong></td>
                      <td><%= nas.shortname || '-' %></td>
                      <td><code title="Gunakan tombol Script untuk melihat konfigurasi">••••••••••••</code></td>
                      <td><%= nas.description || '-' %></td>
                      <td>
                        <% if (nas.is_active) { %>
                          <span class="badge bs">Aktif</span>
                        <% } else { %>
                          <span class="badge bd">Non-Aktif</span>
                        <% } %>
                      </td>
                      <td style="text-align:right;white-space:nowrap;">
                        <button type="button" class="btn btn-s btn-sm" onclick='openNasScript(<%- JSON.stringify(nas) %>)' title="Lihat script MikroTik">
                          <i class="bi bi-terminal"></i> Script
                        </button>
                        <!-- Toggle Status -->
                        <form action="/admin/radius/nas/toggle" method="POST" style="display:inline;">
                          <input type="hidden" name="id" value="<%= nas.id %>">
                          <button type="submit" class="btn btn-g btn-sm" title="<%= nas.is_active ? 'Non-aktifkan NAS' : 'Aktifkan NAS' %>">
                            <i class="bi bi-<%= nas.is_active ? 'pause-circle-fill text-warning' : 'play-circle-fill text-success' %>"></i>
                          </button>
                        </form>
                        <!-- Edit NAS -->
                        <button type="button" class="btn btn-p btn-sm" onclick='openEditNasModal(<%- JSON.stringify(nas) %>)' title="Edit NAS Client">
                          <i class="bi bi-pencil"></i>
                        </button>
                        <form action="/admin/radius/nas/rotate-secret" method="POST" onsubmit="return confirm('Rotasi secret NAS <%= nas.nasname %>? Script lama akan berhenti bekerja setelah FreeRADIUS direstart.')" style="display:inline;">
                          <input type="hidden" name="id" value="<%= nas.id %>">
                          <button type="submit" class="btn btn-w btn-sm" title="Rotasi shared secret"><i class="bi bi-key"></i></button>
                        </form>
                        <!-- Hapus NAS -->
                        <form action="/admin/radius/nas/delete" method="POST" onsubmit="return confirm('Hapus NAS <%= nas.nasname %>?')" style="display:inline;">
                          <input type="hidden" name="id" value="<%= nas.id %>">
                          <button type="submit" class="btn btn-d btn-sm" title="Hapus NAS"><i class="bi bi-trash"></i></button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="text-center text-muted" style="padding:24px;">
                      Belum ada NAS terdaftar. Tambahkan router menggunakan IP L2TP tetap; setiap NAS akan memperoleh secret unik.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 3: SESI ONLINE RADIUS -->
    <div id="tab-content-online" class="tab-pane">
      <div class="card mb16">
        <div class="card-hd" style="display:flex;justify-content:space-between;align-items:center;">
          <h6 style="margin:0;"><i class="bi bi-wifi"></i> Sesi Aktif RADIUS (Active Connections)</h6>
          <% if (onlineSessions && onlineSessions.length > 0) { %>
            <form action="/admin/radius/clear-stale" method="POST" onsubmit="return confirm('Bersihkan semua sesi aktif yang tidak ada pembaruan lebih dari 2 jam?')" style="margin:0;">
              <button type="submit" class="btn btn-w btn-sm" title="Tandai sesi yang sudah tidak ada pembaruan > 2 jam sebagai stopped">
                <i class="bi bi-clock-history"></i> Bersihkan Sesi Usang
              </button>
            </form>
          <% } %>
        </div>
        <div class="card-bd" style="padding:0;">
          <div class="tbl-wrap">
            <table class="dtbl">
              <thead>
                <tr>
                  <th>Username</th>
                  <th>Nama Pelanggan</th>
                  <th>Framed IP</th>
                  <th>NAS IP</th>
                  <th>Upload (In)</th>
                  <th>Download (Out)</th>
                  <th>Durasi Sesi</th>
                  <th>Waktu Update</th>
                  <th style="width:110px;text-align:right;">Aksi</th>
                </tr>
              </thead>
              <tbody>
                <% if (onlineSessions && onlineSessions.length > 0) { %>
                  <% onlineSessions.forEach(s => { %>
                    <%
                      const totalIn = ((s.input_gigawords || 0) * 4294967296) + (s.input_octets || 0);
                      const totalOut = ((s.output_gigawords || 0) * 4294967296) + (s.output_octets || 0);
                      const inMB = totalIn >= 1073741824 ? (totalIn / 1073741824).toFixed(2) + ' GB' : (totalIn / 1048576).toFixed(2) + ' MB';
                      const outMB = totalOut >= 1073741824 ? (totalOut / 1073741824).toFixed(2) + ' GB' : (totalOut / 1048576).toFixed(2) + ' MB';
                      const st = s.session_time || 0;
                      const h = Math.floor(st / 3600);
                      const m = Math.floor((st % 3600) / 60);
                      const sec = st % 60;
                      const stStr = `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`;
                    %>
                    <tr>
                      <td><strong><%= s.username %></strong></td>
                      <td><%= s.customer_name || '<span class="text-muted">-</span>' %></td>
                      <td><%= s.framed_ip || '-' %></td>
                      <td><%= s.nas_ip || '-' %></td>
                      <td><%= inMB %></td>
                      <td><%= outMB %></td>
                      <td><code><%= stStr %></code></td>
                      <td><%= s.updated_at %></td>
                      <td style="text-align:right;white-space:nowrap;">
                        <form action="/admin/radius/disconnect" method="POST" onsubmit="return confirm('Putuskan sesi aktif RADIUS untuk user \'<%= s.username %>\'?')" style="display:inline;">
                          <input type="hidden" name="username" value="<%= s.username %>">
                          <input type="hidden" name="session_id" value="<%= s.session_id %>">
                          <input type="hidden" name="nas_ip" value="<%= s.nas_ip %>">
                           <input type="hidden" name="framed_ip" value="<%= s.framed_ip || '' %>">
                          <button type="submit" class="btn btn-d btn-sm" title="Putuskan Sesi Active RADIUS">
                            <i class="bi bi-power"></i> Putuskan
                          </button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="9" class="text-center text-muted" style="padding:24px;">Belum ada sesi online RADIUS yang terhubung.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 4: LOG ACCOUNTING -->
    <div id="tab-content-accounting" class="tab-pane" style="display:none;">
      <div class="card mb16">
        <div class="card-hd">
          <h6><i class="bi bi-journal-text"></i> Log Accounting RADIUS (100 Terakhir)</h6>
        </div>
        <div class="card-bd" style="padding:0;">
          <div class="tbl-wrap">
            <table class="dtbl">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Username</th>
                  <th>Session ID</th>
                  <th>NAS IP</th>
                  <th>Status Type</th>
                  <th>Upload</th>
                  <th>Download</th>
                  <th>Uptime</th>
                  <th>Timestamp</th>
                </tr>
              </thead>
              <tbody>
                <% if (acctLogs && acctLogs.length > 0) { %>
                  <% acctLogs.forEach(log => { %>
                    <%
                      const logIn = ((log.input_gigawords || 0) * 4294967296) + (log.input_octets || 0);
                      const logOut = ((log.output_gigawords || 0) * 4294967296) + (log.output_octets || 0);
                      const logInStr = logIn >= 1073741824 ? (logIn / 1073741824).toFixed(2) + ' GB' : (logIn / 1048576).toFixed(2) + ' MB';
                      const logOutStr = logOut >= 1073741824 ? (logOut / 1073741824).toFixed(2) + ' GB' : (logOut / 1048576).toFixed(2) + ' MB';
                      const lst = log.session_time || 0;
                      const lh = Math.floor(lst / 3600);
                      const lm = Math.floor((lst % 3600) / 60);
                      const ls = lst % 60;
                      const lstStr = `${String(lh).padStart(2,'0')}:${String(lm).padStart(2,'0')}:${String(ls).padStart(2,'0')}`;
                    %>
                    <tr>
                      <td>#<%= log.id %></td>
                      <td><strong><%= log.username %></strong></td>
                      <td><code><%= log.session_id %></code></td>
                      <td><%= log.nas_ip %></td>
                      <td>
                        <% if (log.status_type === 1) { %>
                          <span class="badge bs">Start</span>
                        <% } else if (log.status_type === 2) { %>
                          <span class="badge bd">Stop</span>
                        <% } else { %>
                          <span class="badge bp">Interim</span>
                        <% } %>
                      </td>
                      <td><%= logInStr %></td>
                      <td><%= logOutStr %></td>
                      <td><code><%= lstStr %></code></td>
                      <td><%= log.created_at %></td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="9" class="text-center text-muted" style="padding:24px;">Belum ada data log accounting RADIUS.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- MODAL TAMBAH NAS -->
<div class="mo" id="addNasModal">
  <div class="mb">
    <div class="mh">
      <div class="mt"><i class="bi bi-plus-circle"></i> Tambah NAS Client RADIUS</div>
      <button type="button" class="mc" onclick="closeModal('addNasModal')">&times;</button>
    </div>
    <form action="/admin/radius/nas/add" method="POST">
      <div class="mbody">
        <div class="fg">
          <label class="fl">IP Address Router NAS</label>
          <input type="text" name="nasname" class="fc" placeholder="Contoh: 192.168.88.1 atau 0.0.0.0" required>
        </div>
        <div class="fg">
          <label class="fl">Nama Singkat Router (Shortname)</label>
          <input type="text" name="shortname" class="fc" placeholder="Contoh: Router-Utama">
        </div>
        <div class="fg">
          <label class="fl">Shared Secret Router</label>
          <input type="text" name="secret" class="fc" placeholder="Kosongkan agar dibuat otomatis (disarankan)">
        </div>
        <div class="fg">
          <label class="fl">Keterangan (Opsional)</label>
          <input type="text" name="description" class="fc" placeholder="Lokasi / Catatan">
        </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('addNasModal')">Batal</button>
        <button type="submit" class="btn btn-p"><i class="bi bi-check-lg"></i> Simpan NAS Client</button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL EDIT NAS -->
<div class="mo" id="editNasModal">
  <div class="mb">
    <div class="mh">
      <div class="mt"><i class="bi bi-pencil-square"></i> Edit NAS Client RADIUS</div>
      <button type="button" class="mc" onclick="closeModal('editNasModal')">&times;</button>
    </div>
    <form action="/admin/radius/nas/edit" method="POST">
      <input type="hidden" name="id" id="edit_nas_id">
      <div class="mbody">
        <div class="fg">
          <label class="fl">IP Address Router NAS</label>
          <input type="text" name="nasname" id="edit_nas_nasname" class="fc" placeholder="Contoh: 192.168.88.1" required>
        </div>
        <div class="fg">
          <label class="fl">Nama Singkat Router (Shortname)</label>
          <input type="text" name="shortname" id="edit_nas_shortname" class="fc" placeholder="Contoh: Router-Utama">
        </div>
        <div class="fg">
          <label class="fl">Shared Secret Router</label>
          <input type="password" name="secret" id="edit_nas_secret" class="fc" placeholder="Kosongkan untuk mempertahankan secret saat ini">
        </div>
        <div class="fg">
          <label class="fl">Keterangan (Opsional)</label>
          <input type="text" name="description" id="edit_nas_description" class="fc" placeholder="Lokasi / Catatan">
        </div>
        <div class="fg">
          <label class="fl">Status NAS Client</label>
          <select name="is_active" id="edit_nas_is_active" class="fs">
            <option value="1">Aktif</option>
            <option value="0">Non-Aktif</option>
          </select>
        </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('editNasModal')">Batal</button>
        <button type="submit" class="btn btn-p"><i class="bi bi-check-lg"></i> Simpan Perubahan</button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL SCRIPT NAS -->
<div class="mo" id="nasScriptModal">
  <div class="mb" style="max-width:760px;">
    <div class="mh">
      <div class="mt"><i class="bi bi-terminal"></i> Script MikroTik L2TP + FreeRADIUS</div>
      <button type="button" class="mc" onclick="closeModal('nasScriptModal')">&times;</button>
    </div>
    <div class="mbody">
      <div class="fg">
        <label class="fl">IP FreeRADIUS yang dapat dijangkau melalui L2TP</label>
        <input type="text" id="script_server_ip" class="fc" value="<%= typeof serverIp !== 'undefined' ? serverIp : '172.17.12.106' %>" oninput="renderNasScript()">
      </div>
      <textarea id="nas_script_area" class="fc" rows="11" readonly style="font-family:monospace;font-size:12px;color:#10b981;background:var(--bg3);"></textarea>
      <small class="text-muted">Script mengaktifkan PPP RADIUS, accounting satu menit, dan CoA UDP 3799. Jalankan hanya setelah akun demo tersedia di FreeRADIUS.</small>
    </div>
    <div class="mf">
      <button type="button" class="btn btn-g" onclick="closeModal('nasScriptModal')">Tutup</button>
      <button type="button" class="btn btn-p" onclick="copyNasScript()"><i class="bi bi-clipboard"></i> Salin Script</button>
    </div>
  </div>
</div>

<script>
  function switchTab(tabId) {
    document.querySelectorAll('.mtab').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-pane').forEach(c => c.style.display = 'none');
    
    const targetBtn = document.getElementById('tab-btn-' + tabId);
    const targetPane = document.getElementById('tab-content-' + tabId);
    
    if (targetBtn) targetBtn.classList.add('active');
    if (targetPane) targetPane.style.display = 'block';
  }

  function showModal(id) {
    const el = document.getElementById(id);
    if (el) el.classList.add('show');
  }

  function closeModal(id) {
    const el = document.getElementById(id);
    if (el) el.classList.remove('show');
  }

  function openEditNasModal(nas) {
    if (!nas) return;
    document.getElementById('edit_nas_id').value = nas.id || '';
    document.getElementById('edit_nas_nasname').value = nas.nasname || '';
    document.getElementById('edit_nas_shortname').value = nas.shortname || '';
    document.getElementById('edit_nas_secret').value = '';
    document.getElementById('edit_nas_description').value = nas.description || '';
    document.getElementById('edit_nas_is_active').value = nas.is_active ? '1' : '0';
    showModal('editNasModal');
  }

  let selectedNasForScript = null;
  function openNasScript(nas) {
    selectedNasForScript = nas;
    renderNasScript();
    showModal('nasScriptModal');
  }
  function renderNasScript() {
    if (!selectedNasForScript) return;
    const serverIp = String(document.getElementById('script_server_ip').value || '').trim();
    const nasIp = String(selectedNasForScript.nasname || '').trim();
    const secret = String(selectedNasForScript.secret || '');
    const normalPool = <%- JSON.stringify(radiusStatus.framedPool || 'pool-pppoe') %>;
    const normalRange = <%- JSON.stringify((radiusStatus.ipPoolStart || '10.250.10.2') + '-' + (radiusStatus.ipPoolEnd || '10.250.10.254')) %>;
    const isolirPool = <%- JSON.stringify(radiusStatus.isolirPool || 'isolir') %>;
    const isolirRange = <%- JSON.stringify((radiusStatus.isolirIpPoolStart || '10.250.99.2') + '-' + (radiusStatus.isolirIpPoolEnd || '10.250.99.254')) %>;
    document.getElementById('nas_script_area').value =
      '# NexaID FreeRADIUS - ' + (selectedNasForScript.shortname || nasIp) + '\n' +
      ':if ([:len [/ip pool find name="' + normalPool + '"]] = 0) do={ /ip pool add name="' + normalPool + '" ranges=' + normalRange + ' }\n' +
      ':if ([:len [/ip pool find name="' + isolirPool + '"]] = 0) do={ /ip pool add name="' + isolirPool + '" ranges=' + isolirRange + ' }\n' +
      '/radius remove [find comment="NEXA-FREERADIUS"]\n' +
      '/radius add service=ppp address=' + serverIp + ' src-address=' + nasIp + ' secret="' + secret + '" authentication-port=1812 accounting-port=1813 timeout=3s require-message-auth=yes comment="NEXA-FREERADIUS"\n' +
      '/radius incoming set accept=yes port=3799\n' +
      '/ppp aaa set use-radius=yes accounting=yes interim-update=1m\n';
  }
  function copyNasScript() {
    const el = document.getElementById('nas_script_area');
    navigator.clipboard.writeText(el.value).then(() => alert('Script MikroTik berhasil disalin.'));
  }

  const requestedTab = new URLSearchParams(window.location.search).get('tab');
  if (requestedTab) switchTab(requestedTab);

  // Auto dismiss notification alert after 4 seconds
  setTimeout(() => {
    const alertEl = document.getElementById('autoAlert');
    if (alertEl) {
      alertEl.style.transition = 'opacity 0.5s ease, max-height 0.5s ease, margin 0.5s ease, padding 0.5s ease';
      alertEl.style.opacity = '0';
      alertEl.style.maxHeight = '0';
      alertEl.style.margin = '0';
      alertEl.style.padding = '0';
      alertEl.style.overflow = 'hidden';
      setTimeout(() => alertEl.remove(), 500);
    }
  }, 4000);
</script>
</body>
</html>
