<!DOCTYPE html>
<html class="scroll-smooth" lang="<%= typeof lang !== 'undefined' ? lang : 'id' %>">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title><%= settings.company_header || 'NexaID Billing' %> - Portal Layanan & Internet Fiber Optic Tercepat</title>

  <!-- Google Fonts: Plus Jakarta Sans -->
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>

  <!-- FontAwesome Icons -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet"/>

  <!-- Tailwind CSS v3 with Plugins -->
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

  <!-- PWA Meta Tags -->
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#070B14">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="icon" type="image/svg+xml" href="/img/favicon.svg?v=2">
  <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32x32.png?v=2">
  <link rel="icon" type="image/png" sizes="192x192" href="/img/favicon-192x192.png?v=2">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png?v=2">
  <link rel="shortcut icon" href="/favicon.ico?v=2">

  <!-- Tailwind Custom Config -->
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#eff6ff',
              100: '#dbeafe',
              500: '#3b82f6',
              600: '#2563eb',
              700: '#1d4ed8',
              900: '#1e3a8a',
            },
            surface: {
              dark: '#080c15',
              card: '#0f172a',
              cardHover: '#131e36',
              border: 'rgba(51, 65, 85, 0.45)',
              glow: 'rgba(59, 130, 246, 0.12)'
            },
            accent: {
              gold: '#f59e0b',
              goldHover: '#d97706',
              cyan: '#06b6d4',
              emerald: '#10b981'
            }
          },
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
          boxShadow: {
            'glow-blue': '0 0 35px -5px rgba(37, 99, 235, 0.3)',
            'glow-amber': '0 0 25px -5px rgba(245, 158, 11, 0.25)',
            'glass': '0 8px 32px 0 rgba(0, 0, 0, 0.37)'
          }
        }
      }
    }
  </script>

  <style data-purpose="base-styling">
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: #070B14;
      color: #E2E8F0;
      overflow-x: hidden;
    }
    .hero-glow-bg {
      background: radial-gradient(circle at 50% 15%, rgba(37, 99, 235, 0.18) 0%, rgba(7, 11, 20, 0) 70%);
    }
    .glass-nav {
      background: rgba(11, 17, 32, 0.85);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
    }
    .glass-card {
      background: rgba(15, 23, 42, 0.65);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .glass-card-interactive {
      transition: all 0.25s ease-in-out;
    }
    .glass-card-interactive:hover {
      border-color: rgba(96, 165, 250, 0.4);
      transform: translateY(-4px);
      box-shadow: 0 16px 30px -10px rgba(37, 99, 235, 0.2);
    }
  </style>
</head>

<body class="min-h-screen flex flex-col antialiased selection:bg-brand-500 selection:text-white">

  <!-- BEGIN: MainHeader -->
  <header class="fixed top-0 left-0 w-full z-50 glass-nav border-b border-slate-800/80 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      
      <!-- Logo Brand -->
      <a aria-label="Home" class="flex items-center gap-3 group" href="#beranda">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-brand-700 via-brand-600 to-cyan-400 p-0.5 shadow-glow-blue flex items-center justify-center group-hover:scale-105 transition-transform overflow-hidden">
          <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center p-1">
            <img src="/img/logo.png" alt="Logo" class="max-h-full max-w-full object-contain" onerror="this.style.display='none'; document.getElementById('default-icon').style.display='block';">
            <i id="default-icon" class="fa-solid fa-bolt-lightning text-cyan-400 text-lg hidden"></i>
          </div>
        </div>
        <div class="flex flex-col">
          <div class="flex items-center gap-1.5">
            <span class="text-xl font-extrabold tracking-tight text-white"><%= settings.company_header || 'NexaID Billing' %></span>
            <span class="text-xs uppercase font-bold tracking-wider px-1.5 py-0.5 rounded bg-brand-500/20 text-brand-400 border border-brand-500/30">FIBER</span>
          </div>
          <span class="text-[11px] font-medium tracking-wide text-slate-400 uppercase">Billing & Customer Portal</span>
        </div>
      </a>

      <!-- Navigation Links with Modern Dropdowns -->
      <nav class="hidden lg:flex items-center gap-1.5 text-sm font-medium text-slate-300">
        <!-- 1. Beranda -->
        <a class="px-3 py-2 rounded-xl text-white hover:bg-slate-800/60 transition-colors flex items-center gap-2" href="#beranda">
          <i class="fa-solid fa-house-chimney text-xs text-brand-400"></i>
          <span>Beranda</span>
        </a>

        <!-- 2. Dropdown: Layanan & Paket -->
        <div class="relative group">
          <button type="button" class="px-3 py-2 rounded-xl hover:text-white hover:bg-slate-800/60 transition-colors flex items-center gap-2 focus:outline-none">
            <i class="fa-solid fa-wifi text-xs text-cyan-400"></i>
            <span>Layanan &amp; Paket</span>
            <i class="fa-solid fa-chevron-down text-[10px] text-slate-400 transition-transform duration-200 group-hover:rotate-180"></i>
          </button>
          <div class="absolute left-0 mt-2 w-72 bg-slate-900/95 backdrop-blur-2xl border border-slate-700/70 rounded-2xl shadow-2xl p-2.5 opacity-0 invisible translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200 z-50">
            <a href="#paket" class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-800/80 transition-colors group/item">
              <div class="w-8 h-8 rounded-lg bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 flex items-center justify-center shrink-0 mt-0.5 group-hover/item:scale-110 transition-transform">
                <i class="fa-solid fa-list-check text-xs"></i>
              </div>
              <div>
                <div class="text-xs font-bold text-white group-hover/item:text-cyan-400 transition-colors">Paket &amp; Tarif Internet</div>
                <p class="text-[11px] text-slate-400 mt-0.5">Pilihan kecepatan &amp; harga bulanan</p>
              </div>
            </a>
            <a href="/customer/register" class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-800/80 transition-colors group/item">
              <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5 group-hover/item:scale-110 transition-transform">
                <i class="fa-solid fa-user-plus text-xs"></i>
              </div>
              <div>
                <div class="text-xs font-bold text-white group-hover/item:text-emerald-400 transition-colors">Daftar Pasang Baru</div>
                <p class="text-[11px] text-slate-400 mt-0.5">Registrasi jaringan fiber optik baru</p>
              </div>
            </a>
            <a href="/customer/voucher" class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-800/80 transition-colors group/item">
              <div class="w-8 h-8 rounded-lg bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center shrink-0 mt-0.5 group-hover/item:scale-110 transition-transform">
                <i class="fa-solid fa-ticket text-xs"></i>
              </div>
              <div>
                <div class="text-xs font-bold text-white group-hover/item:text-amber-400 transition-colors">Beli Voucher Hotspot</div>
                <p class="text-[11px] text-slate-400 mt-0.5">Beli kode voucher Wi-Fi via QRIS</p>
              </div>
            </a>
            <a href="#keunggulan" class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-800/80 transition-colors group/item">
              <div class="w-8 h-8 rounded-lg bg-blue-500/10 border border-blue-500/20 text-blue-400 flex items-center justify-center shrink-0 mt-0.5 group-hover/item:scale-110 transition-transform">
                <i class="fa-solid fa-shield-halved text-xs"></i>
              </div>
              <div>
                <div class="text-xs font-bold text-white group-hover/item:text-blue-400 transition-colors">Keunggulan Jaringan</div>
                <p class="text-[11px] text-slate-400 mt-0.5">100% Fiber Optic, No FUP &amp; 99.9% SLA</p>
              </div>
            </a>
          </div>
        </div>

        <!-- 3. Dropdown: Layanan Mandiri (Self Service) -->
        <div class="relative group">
          <button type="button" class="px-3 py-2 rounded-xl hover:text-white hover:bg-slate-800/60 transition-colors flex items-center gap-2 focus:outline-none">
            <i class="fa-regular fa-calendar-check text-xs text-brand-400"></i>
            <span>Layanan Mandiri</span>
            <i class="fa-solid fa-chevron-down text-[10px] text-slate-400 transition-transform duration-200 group-hover:rotate-180"></i>
          </button>
          <div class="absolute left-0 mt-2 w-72 bg-slate-900/95 backdrop-blur-2xl border border-slate-700/70 rounded-2xl shadow-2xl p-2.5 opacity-0 invisible translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200 z-50">
            <a href="/customer/check-billing" class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-800/80 transition-colors group/item">
              <div class="w-8 h-8 rounded-lg bg-brand-500/10 border border-brand-500/20 text-brand-400 flex items-center justify-center shrink-0 mt-0.5 group-hover/item:scale-110 transition-transform">
                <i class="fa-solid fa-receipt text-xs"></i>
              </div>
              <div>
                <div class="text-xs font-bold text-white group-hover/item:text-brand-400 transition-colors">Cek &amp; Bayar Tagihan</div>
                <p class="text-[11px] text-slate-400 mt-0.5">Cek rincian invoice &amp; bayar online</p>
              </div>
            </a>
            <a href="https://fast.com" target="_blank" rel="noopener" class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-800/80 transition-colors group/item">
              <div class="w-8 h-8 rounded-lg bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 flex items-center justify-center shrink-0 mt-0.5 group-hover/item:scale-110 transition-transform">
                <i class="fa-solid fa-gauge-high text-xs"></i>
              </div>
              <div>
                <div class="text-xs font-bold text-white group-hover/item:text-cyan-400 transition-colors">Uji Kecepatan (Speedtest)</div>
                <p class="text-[11px] text-slate-400 mt-0.5">Tes kecepatan download &amp; upload</p>
              </div>
            </a>
            <a href="<%= settings.company_phone ? 'https://wa.me/' + String(settings.company_phone).replace(/\\D/g, '') : '#informasi' %>" target="_blank" rel="noopener" class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-800/80 transition-colors group/item">
              <div class="w-8 h-8 rounded-lg bg-rose-500/10 border border-rose-500/20 text-rose-400 flex items-center justify-center shrink-0 mt-0.5 group-hover/item:scale-110 transition-transform">
                <i class="fa-solid fa-headset text-xs"></i>
              </div>
              <div>
                <div class="text-xs font-bold text-white group-hover/item:text-rose-400 transition-colors">Pusat Bantuan &amp; CS</div>
                <p class="text-[11px] text-slate-400 mt-0.5">Laporkan kendala &amp; respon cepat</p>
              </div>
            </a>
          </div>
        </div>

        <!-- 4. Dropdown: Portal Akses Petugas -->
        <div class="relative group">
          <button type="button" class="px-3 py-2 rounded-xl hover:text-white hover:bg-slate-800/60 transition-colors flex items-center gap-2 focus:outline-none">
            <i class="fa-solid fa-users-gear text-xs text-purple-400"></i>
            <span>Portal Akses</span>
            <i class="fa-solid fa-chevron-down text-[10px] text-slate-400 transition-transform duration-200 group-hover:rotate-180"></i>
          </button>
          <div class="absolute left-0 mt-2 w-72 bg-slate-900/95 backdrop-blur-2xl border border-slate-700/70 rounded-2xl shadow-2xl p-2.5 opacity-0 invisible translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200 z-50">
            <a href="/admin" class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-800/80 transition-colors group/item">
              <div class="w-8 h-8 rounded-lg bg-blue-500/10 border border-blue-500/20 text-blue-400 flex items-center justify-center shrink-0 mt-0.5 group-hover/item:scale-110 transition-transform">
                <i class="fa-solid fa-shield text-xs"></i>
              </div>
              <div>
                <div class="text-xs font-bold text-white group-hover/item:text-blue-400 transition-colors">Portal Administrator</div>
                <p class="text-[11px] text-slate-400 mt-0.5">Dashboard manajemen billing &amp; jaringan</p>
              </div>
            </a>
            <a href="/tech" class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-800/80 transition-colors group/item">
              <div class="w-8 h-8 rounded-lg bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 flex items-center justify-center shrink-0 mt-0.5 group-hover/item:scale-110 transition-transform">
                <i class="fa-solid fa-wrench text-xs"></i>
              </div>
              <div>
                <div class="text-xs font-bold text-white group-hover/item:text-cyan-400 transition-colors">Portal Teknisi Lapangan</div>
                <p class="text-[11px] text-slate-400 mt-0.5">Peta ODP, cek ONU &amp; tiket SPK</p>
              </div>
            </a>
            <a href="/agent" class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-800/80 transition-colors group/item">
              <div class="w-8 h-8 rounded-lg bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center shrink-0 mt-0.5 group-hover/item:scale-110 transition-transform">
                <i class="fa-solid fa-shop text-xs"></i>
              </div>
              <div>
                <div class="text-xs font-bold text-white group-hover/item:text-amber-400 transition-colors">Mitra Agen &amp; Reseller</div>
                <p class="text-[11px] text-slate-400 mt-0.5">Loket bayar tagihan &amp; penjualan pulsa</p>
              </div>
            </a>
            <a href="/collector" class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-800/80 transition-colors group/item">
              <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5 group-hover/item:scale-110 transition-transform">
                <i class="fa-solid fa-hand-holding-dollar text-xs"></i>
              </div>
              <div>
                <div class="text-xs font-bold text-white group-hover/item:text-emerald-400 transition-colors">Petugas Kolektor</div>
                <p class="text-[11px] text-slate-400 mt-0.5">Penagihan lapangan &amp; cetak struk</p>
              </div>
            </a>
            <div class="pt-2 mt-1 border-t border-slate-800">
              <button type="button" onclick="triggerPwaInstall()" class="w-full flex items-center justify-between p-2 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400 hover:bg-amber-500/20 transition-all text-xs font-semibold">
                <span class="flex items-center gap-2">
                  <i class="fa-solid fa-mobile-screen-button text-xs"></i>
                  <span>Install Aplikasi Pelanggan</span>
                </span>
                <i class="fa-solid fa-download text-[10px]"></i>
              </button>
            </div>
          </div>
        </div>

        <!-- 5. Informasi & Legal -->
        <a class="px-3 py-2 rounded-xl hover:text-white hover:bg-slate-800/60 transition-colors flex items-center gap-2" href="#informasi">
          <i class="fa-solid fa-circle-info text-xs text-amber-400"></i>
          <span>Informasi</span>
        </a>
      </nav>

      <!-- Action Buttons -->
      <div class="flex items-center gap-2.5">
        <!-- Cek Tagihan Cepat -->
        <a class="hidden sm:inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold bg-slate-800/80 hover:bg-slate-700/80 border border-slate-700 text-slate-200 hover:text-white transition-all shadow-sm" href="/customer/check-billing">
          <i class="fa-regular fa-receipt text-xs text-brand-400"></i>
          <span>Cek Tagihan</span>
        </a>

        <!-- Masuk Portal Primary Button -->
        <a class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold bg-gradient-to-r from-brand-600 to-brand-500 hover:from-brand-500 hover:to-brand-400 text-white shadow-glow-blue hover:shadow-lg transition-all duration-200" href="#portal">
          <i class="fa-solid fa-right-to-bracket text-xs"></i>
          <span>Masuk Portal</span>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button type="button" onclick="toggleMobileMenu()" class="lg:hidden p-2 rounded-xl bg-slate-800/80 text-slate-300 hover:text-white border border-slate-700">
          <i class="fa-solid fa-bars text-base"></i>
        </button>
      </div>

    </div>

    <!-- Mobile Navigation Drawer Grouped -->
    <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-800 bg-slate-950/98 backdrop-blur-2xl px-4 py-5 space-y-4 max-h-[85vh] overflow-y-auto">
      
      <!-- Kategori 1: Navigasi Utama -->
      <div>
        <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500 px-3 mb-1.5">Navigasi Utama</div>
        <div class="space-y-1">
          <a class="flex items-center gap-3 px-3 py-2 rounded-xl text-white font-medium hover:bg-slate-800/60" href="#beranda" onclick="toggleMobileMenu()">
            <i class="fa-solid fa-house-chimney text-xs text-brand-400 w-4"></i>
            <span>Beranda</span>
          </a>
          <a class="flex items-center gap-3 px-3 py-2 rounded-xl text-slate-300 font-medium hover:bg-slate-800/60" href="#paket" onclick="toggleMobileMenu()">
            <i class="fa-solid fa-list-check text-xs text-cyan-400 w-4"></i>
            <span>Paket &amp; Tarif Internet</span>
          </a>
          <a class="flex items-center gap-3 px-3 py-2 rounded-xl text-slate-300 font-medium hover:bg-slate-800/60" href="/customer/register">
            <i class="fa-solid fa-user-plus text-xs text-emerald-400 w-4"></i>
            <span>Daftar Pasang Baru</span>
          </a>
          <a class="flex items-center gap-3 px-3 py-2 rounded-xl text-slate-300 font-medium hover:bg-slate-800/60" href="/customer/voucher">
            <i class="fa-solid fa-ticket text-xs text-amber-400 w-4"></i>
            <span>Beli Voucher Hotspot</span>
          </a>
        </div>
      </div>

      <!-- Kategori 2: Layanan Mandiri -->
      <div class="pt-2 border-t border-slate-800/80">
        <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500 px-3 mb-1.5">Layanan Mandiri</div>
        <div class="space-y-1">
          <a class="flex items-center gap-3 px-3 py-2 rounded-xl text-slate-300 font-medium hover:bg-slate-800/60" href="/customer/check-billing">
            <i class="fa-regular fa-receipt text-xs text-brand-400 w-4"></i>
            <span>Cek &amp; Bayar Tagihan</span>
          </a>
          <a class="flex items-center gap-3 px-3 py-2 rounded-xl text-slate-300 font-medium hover:bg-slate-800/60" href="https://fast.com" target="_blank" rel="noopener">
            <i class="fa-solid fa-gauge-high text-xs text-cyan-400 w-4"></i>
            <span>Uji Kecepatan (Speedtest)</span>
          </a>
          <a class="flex items-center gap-3 px-3 py-2 rounded-xl text-slate-300 font-medium hover:bg-slate-800/60" href="#keunggulan" onclick="toggleMobileMenu()">
            <i class="fa-solid fa-shield-halved text-xs text-blue-400 w-4"></i>
            <span>Keunggulan Layanan</span>
          </a>
          <a class="flex items-center gap-3 px-3 py-2 rounded-xl text-slate-300 font-medium hover:bg-slate-800/60" href="#informasi" onclick="toggleMobileMenu()">
            <i class="fa-solid fa-circle-info text-xs text-amber-400 w-4"></i>
            <span>Informasi Perusahaan</span>
          </a>
        </div>
      </div>

      <!-- Kategori 3: Portal Petugas & Aplikasi -->
      <div class="pt-2 border-t border-slate-800/80">
        <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500 px-3 mb-1.5">Portal Petugas &amp; Aplikasi</div>
        <div class="grid grid-cols-2 gap-2 mb-2.5">
          <a class="text-center py-2 px-3 rounded-xl text-xs font-semibold bg-slate-900 border border-slate-800 text-slate-300 hover:text-white" href="/admin">Admin Panel</a>
          <a class="text-center py-2 px-3 rounded-xl text-xs font-semibold bg-slate-900 border border-slate-800 text-slate-300 hover:text-white" href="/tech">Teknisi</a>
          <a class="text-center py-2 px-3 rounded-xl text-xs font-semibold bg-slate-900 border border-slate-800 text-slate-300 hover:text-white" href="/agent">Mitra Agen</a>
          <a class="text-center py-2 px-3 rounded-xl text-xs font-semibold bg-slate-900 border border-slate-800 text-slate-300 hover:text-white" href="/collector">Kolektor</a>
        </div>
        <button type="button" onclick="triggerPwaInstall()" class="w-full py-2.5 px-3 rounded-xl text-xs font-bold bg-amber-500/15 border border-amber-500/30 text-amber-400 flex items-center justify-center gap-2">
          <i class="fa-solid fa-download text-xs"></i>
          <span>Install Aplikasi Pelanggan</span>
        </button>
      </div>

    </div>
  </header>
  <!-- END: MainHeader -->

  <!-- BEGIN: MainContent -->
  <main class="flex-grow pt-24 sm:pt-28">

    <!-- BEGIN: HeroSection -->
    <section class="relative hero-glow-bg pt-8 pb-16 lg:pt-14 lg:pb-24" id="beranda">
      <!-- Decorative Background Orbs -->
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-brand-600/10 rounded-full blur-[110px] pointer-events-none -z-10"></div>
      <div class="absolute top-1/3 right-10 w-[350px] h-[250px] bg-cyan-600/10 rounded-full blur-[90px] pointer-events-none -z-10"></div>

