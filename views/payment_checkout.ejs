<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Pembayaran Tagihan | <%= settings.company_header || 'NexaID Billing' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    :root{--navy:#0f172a;--panel:#fff;--line:#e2e8f0;--muted:#64748b;--primary:#4f46e5;--accent:#06b6d4}
    *{box-sizing:border-box}body{margin:0;background:#f8fafc;color:#0f172a;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}
    .topbar{background:linear-gradient(110deg,#0f172a,#1e293b);color:#fff;padding:22px 0;box-shadow:0 5px 20px rgba(15,23,42,.14)}
    .wrap{width:min(1180px,calc(100% - 32px));margin:auto}.brand{display:flex;align-items:center;gap:14px;font-size:22px;font-weight:800}
    .brand img{width:52px;height:52px;object-fit:contain;background:#fff;border-radius:12px;padding:5px}.brand-mark{width:46px;height:46px;border-radius:13px;display:grid;place-items:center;background:linear-gradient(135deg,var(--primary),var(--accent));font-size:23px}
    main{padding:42px 0}.grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(330px,.85fr);gap:28px}.card{background:var(--panel);border:1px solid var(--line);border-radius:20px;box-shadow:0 18px 45px rgba(15,23,42,.07);padding:28px}
    .eyebrow{font-size:12px;font-weight:800;color:var(--primary);letter-spacing:.11em;text-transform:uppercase}.hello{font-size:30px;margin:8px 0}.invoice-title{font-size:18px;font-weight:750;margin-bottom:28px}.money{color:#0f766e}
    .gateway{width:100%;display:flex;align-items:center;gap:16px;text-align:left;padding:20px;border:2px solid var(--line);border-radius:16px;background:#fff;cursor:pointer;transition:.2s}.gateway:hover,.gateway.selected{border-color:#6366f1;background:#eef2ff;box-shadow:0 8px 24px rgba(79,70,229,.12)}
    .gateway-icon{width:48px;height:48px;border-radius:14px;display:grid;place-items:center;background:linear-gradient(135deg,#eef2ff,#cffafe);color:#4f46e5;font-size:25px}.gateway-name{font-size:18px;font-weight:800}.gateway-sub{font-size:13px;color:var(--muted);margin-top:3px}.arrow{margin-left:auto;font-size:22px}
    .methods{display:none;margin-top:18px;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.methods.show{display:grid}.method{padding:13px;border:1px solid var(--line);border-radius:12px;background:#fff;cursor:pointer;text-align:left;color:#334155}.method.selected{border-color:#4f46e5;background:#eef2ff;color:#312e81}.method strong{display:block;font-size:13px}.method span{font-size:11px;color:var(--muted)}
    .pay{width:100%;margin-top:22px;border:0;border-radius:13px;padding:15px;font-size:15px;font-weight:850;color:#fff;background:linear-gradient(135deg,#4f46e5,#06b6d4);cursor:pointer}.pay:disabled{background:#cbd5e1;color:#64748b;cursor:not-allowed}.back{display:inline-block;margin-top:17px;color:#64748b;text-decoration:none;font-size:13px}
    .summary h2{text-align:center;font-size:20px;margin:0 0 24px}.row{display:flex;justify-content:space-between;gap:20px;padding:14px 0;border-bottom:1px solid var(--line)}.row span:first-child{color:var(--muted)}.row strong{text-align:right}.row.total{font-size:18px;border-bottom:0;padding-top:20px}.detail{margin-top:18px;background:#f8fafc;border-radius:14px;padding:16px;font-size:13px;color:#475569}.secure{display:flex;gap:9px;align-items:center;margin-top:18px;color:#0f766e;font-size:12px;font-weight:700}
    @media(max-width:820px){main{padding:24px 0}.grid{grid-template-columns:1fr}.summary{order:-1}.card{padding:21px}.hello{font-size:24px}.methods{grid-template-columns:1fr}}
  </style>
</head>
<body>
  <header class="topbar"><div class="wrap"><div class="brand">
    <% if (settings.company_logo) { %><img src="<%= settings.company_logo %>" alt="Logo"><% } else { %><div class="brand-mark"><i class="bi bi-wifi"></i></div><% } %>
    <span><%= settings.company_header || 'NexaID Billing' %></span>
  </div></div></header>
  <main><div class="wrap"><div class="grid">
    <section class="card">
      <div class="eyebrow">Pembayaran aman</div>
      <h1 class="hello">Hai, <%= (customer && customer.name) || invoice.customer_name || 'Pelanggan' %> 👋</h1>
      <div class="invoice-title">Bayar Invoice #<%= String(invoice.invoice_number || invoice.id).padStart(6,'0') %> — <span class="money">Rp <%= Number(invoice.amount || 0).toLocaleString('id-ID') %></span></div>

      <button class="gateway" id="gatewayCard" type="button" aria-expanded="false">
        <div class="gateway-icon"><i class="bi bi-shield-check"></i></div>
        <div><div class="gateway-name"><%= gateway === 'xendit' ? 'Xendit Indonesia' : gateway.toUpperCase() %></div><div class="gateway-sub">Pilih metode pembayaran yang tersedia</div></div>
        <i class="bi bi-chevron-right arrow"></i>
      </button>

      <div class="methods" id="methods">
        <% paymentChannels.forEach((channel, index) => { %>
          <button type="button" class="method" data-method="<%= channel.code %>"><strong><%= channel.name %></strong><span><%= channel.group || 'Pembayaran Online' %></span></button>
        <% }) %>
      </div>
      <button class="pay" id="payButton" type="button" disabled>PAY NOW</button>
      <a class="back" href="<%= backUrl %>"><i class="bi bi-arrow-left"></i> Kembali ke tagihan</a>
    </section>

    <aside class="card summary">
      <h2>Ringkasan</h2>
      <div class="row"><span>Deskripsi</span><strong>Internet · <%= invoice.package_name || 'Paket Internet' %><br><small>Periode <%= invoice.period_month %>/<%= invoice.period_year %></small></strong></div>
      <div class="row"><span>Subtotal</span><strong>Rp <%= Number(invoice.amount || 0).toLocaleString('id-ID') %></strong></div>
      <div class="row"><span>Biaya layanan</span><strong>Rp 0</strong></div>
      <div class="row total"><span><strong>Total</strong></span><strong>Rp <%= Number(invoice.amount || 0).toLocaleString('id-ID') %></strong></div>
      <div class="detail">Invoice #<%= String(invoice.invoice_number || invoice.id).padStart(6,'0') %><br><%= (customer && customer.address) || invoice.address || '' %></div>
      <div class="secure"><i class="bi bi-lock-fill"></i> Transaksi diproses melalui kanal pembayaran resmi.</div>
    </aside>
  </div></div></main>
  <script>
    const gatewayCard = document.getElementById('gatewayCard');
    const methods = document.getElementById('methods');
    const payButton = document.getElementById('payButton');
    let selectedMethod = '';
    gatewayCard.addEventListener('click', () => {
      const open = methods.classList.toggle('show');
      gatewayCard.classList.toggle('selected', open);
      gatewayCard.setAttribute('aria-expanded', String(open));
    });
    document.querySelectorAll('.method').forEach(button => button.addEventListener('click', () => {
      document.querySelectorAll('.method').forEach(item => item.classList.remove('selected'));
      button.classList.add('selected');
      selectedMethod = button.dataset.method;
      payButton.disabled = false;
      payButton.textContent = 'BAYAR SEKARANG';
    }));
    payButton.addEventListener('click', () => {
      if (!selectedMethod) return;
      payButton.disabled = true;
      payButton.textContent = 'MEMPROSES...';
      const token = <%- JSON.stringify(publicToken || '') %>;
      const query = new URLSearchParams({ method: selectedMethod });
      if (token) query.set('t', token);
      window.location.href = `/customer/payment/create/<%= encodeURIComponent(String(invoice.id)) %>?${query.toString()}`;
    });
  </script>
</body>
</html>
